[Unit]
Description=AdCreateHub remote control panel
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/adcreatehub
# Auth: Google Cloud ADC (user login via `gcloud auth application-default
# login`) is picked up from the service user's $HOME/.config/gcloud/. No
# service-account key file is required or expected inside the repo.
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/adcreatehub/venv/bin/python /home/ubuntu/adcreatehub/controller.py
Restart=always
RestartSec=5
Environment=BANANA_AUTH=gav:minion01

[Install]
WantedBy=multi-user.target
